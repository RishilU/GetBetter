# Copy to .env.local for local `vercel dev`, and set the same three as
# Production env vars in the Vercel project dashboard before deploying.

# The passphrase you'll type on the login page.
SITE_PASSWORD=

# Random long string used to sign the login cookie. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=

# From https://console.anthropic.com/settings/keys — powers AI journal linking.
ANTHROPIC_API_KEY=

# Cross-device sync (api/data.js) needs a private Vercel Blob store — no env
# var to set by hand. In the Vercel dashboard: Storage tab -> Create Database
# -> Blob -> access: Private -> connect it to this project. Vercel injects
# the OIDC credentials automatically. For local `vercel dev`, run
# `vercel env pull` afterward so this file picks up BLOB_STORE_ID etc.
